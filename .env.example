PORT=5000
MONGODB_URI=mongodb://localhost:27017/whatsapp_saas
JWT_SECRET=your_super_secret_jwt_key_change_in_production
REDIS_URL=redis://localhost:6379
SESSIONS_DIR=./sessions
MIN_DELAY_MS=20000
MAX_DELAY_MS=30000
WA_INIT_TIMEOUT_MS=180000
WA_INIT_MAX_RETRIES=1
WA_INIT_RETRY_BASE_DELAY_MS=5000
WA_INIT_RETRY_MAX_DELAY_MS=30000
# Chromium profile lock retry (Docker hostname change after redeploy)
WA_LOCK_RETRY_DELAY_MS=2000
# QR: first code + one retry, then Chromium stops (saves RAM)
WA_QR_MAX_REFRESHES=2
WA_QR_PENDING_TIMEOUT_MS=180000
WA_QR_THROTTLE_MS=20000
# Boot restore: 1 client at a time avoids OOM and profile lock races
WA_RESTORE_BATCH_SIZE=1
WA_RESTORE_BATCH_DELAY_MS=5000
# Boot restore: wait for old container to stop before reconnecting (rolling deploys)
WA_BOOT_RESTORE_DELAY_MS=20000
# Optional: delay auto-resume of interrupted campaigns after boot
WA_BOOT_CAMPAIGN_RESUME_DELAY_MS=45000
# Optional: persistent file used to recover running campaigns across graceful restarts
CAMPAIGN_RECOVERY_FILE=./sessions/.campaign-recovery.json
CORS_ORIGINS=https://whatsap-sigma.vercel.app
NODE_ENV=development
QR_SHARE_TOKEN=put_a_long_random_string_here

# OTP — Option A: Laravel WHATSAPP_NODE_TOKEN (JWT, no OTP_SERVICE_SECRET needed)
# OTP — Option B: OTP_SERVICE_SECRET + header X-Service-Key
OTP_SERVICE_SECRET=
OTP_DEFAULT_CLIENT_ID=
OTP_EXPIRES_MINUTES=5
OTP_MESSAGE_TEMPLATE=Your verification code is: {code}. Valid for {minutes} minutes. Do not share this code.
# Laravel otp_* campaigns: skip message balance + send synchronously on /start
OTP_CAMPAIGN_SKIP_BALANCE=true

# SMTP (optional — balance alerts + WhatsApp disconnect alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=walidrifaii53@gmail.com
SMTP_PASS=walid#2212
SMTP_FROM=walidrifaii51@gmail.com
# Email when any WhatsApp client disconnects or auth fails (per user, per client)
WHATSAPP_DISCONNECT_EMAIL_ENABLED=true
WHATSAPP_DISCONNECT_EMAIL_COOLDOWN_MS=1800000
